# ─── Veritabanı ───────────────────────────────────────────────
DATABASE_URL="file:./prisma/dev.db"

# ─── NextAuth ──────────────────────────────────────────────────
# NEXTAUTH_SECRET: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ─── Şifreleme ─────────────────────────────────────────────────
# ENCRYPTION_KEY: openssl rand -hex 32  (TAM 64 karakter olmalı!)
ENCRYPTION_KEY=""

# ─── Otomasyon ─────────────────────────────────────────────────
AUTOMATION_SECRET=""
APP_URL="http://localhost:3000"

# ─── Cloudflare Worker (opsiyonel) ─────────────────────────────
CLOUDFLARE_WORKER_URL=""
CLOUDFLARE_WORKER_SECRET=""

# ─── Site URL ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── NOT ───────────────────────────────────────────────────────
# API anahtarlarını (DeepSeek, OpenAI, Pexels, YouTube, Telegram
# NewsAPI, vb.) buraya YAZMAYIN.
# SuperAdmin → API Ayarları panelinden girin.
# Orada girilen key'ler şifreli olarak veritabanında saklanır.
